<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Include-only, as backup_rules.xml: shared_prefs/ (calibration.xml, sampler_state.xml) stays on the device. -->
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
